{
    "manifest_version": 3,
    "name": "No Shorts, Just Do It",
    "version": "1.0.0",
    "description": "YouTube Shortsを開くとJust Do It動画へリダイレクトします。",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions": [
        "webNavigation"
    ],
    "host_permissions": [
        "https://www.youtube.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    }
}
